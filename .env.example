# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=llm_user
DB_PASSWORD=your_secure_password_here
DB_NAME=llm_system

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=jwt_secret_key

# API Gateway
API_GATEWAY_PORT=8080
ANALYTICS_DAILY_LIMIT=5
SIMPLE_DAILY_LIMIT=20

# Debate Orchestrator
DEBATE_ORCHESTRATOR_PORT=8082

# Yandex AI Studio — один ключ для всех моделей
# Получить: https://console.yandex.cloud → AI Studio → API Keys
YANDEX_API_KEY=your_yandex_api_key_here


# Модели по умолчанию. Полный список можно посмотреть на https://aistudio.yandex.ru/platform/folders/b1gia657c260lti959oh/models
# Чтобы заменить модель, находим нужную и копируем ее URI. Важно также отключить всем thinking через изменение кода в debate_orchestrator, иначе дебатеры нарушат все лимиты

# Модели дебатёров (по умолчанию)
DEBATER_A_MODEL=gpt://b1gia657c260lti959oh/yandexgpt-lite/latest
DEBATER_B_MODEL=gpt://b1gia657c260lti959oh/deepseek-v32/latest
DEBATER_C_MODEL=gpt://b1gia657c260lti959oh/yandexgpt-lite/latest
# Judge
JUDGE_MODEL=gpt://b1gia657c260lti959oh/yandexgpt-5.1/latest
# Модель для обычного режима (один вызов без дебатов)
SIMPLE_MODEL=simple_model
# Лимит токенов для обычного режима (yandexgpt-lite ограничен ~2000 токенами вывода)
SIMPLE_MODEL=gpt://b1gia657c260lti959oh/yandexgpt-lite/latest

# Лимиты токенов
DEBATER_MAX_TOKENS=1024
JUDGE_MAX_TOKENS=2048

# Максимальное время ожидания дебатов (секунды). По умолчанию 300 (5 минут).
DEBATE_TIMEOUT_SECONDS=300

# Режим заглушки — не тратит токены, отвечает фиксированной фразой.
# Удобно для тестирования бота и бэкенда без обращений к LLM API.
# Допустимые значения: true / false (по умолчанию false)
DEBUG_BACKEND=false

# Telegram Bot
TELEGRAM_BOT_TOKEN=example_token
TELEGRAM_API_GATEWAY_URL=http://api-gateway:8080

# Environment
ENVIRONMENT=development
