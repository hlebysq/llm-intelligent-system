# Container Registry
YC_REGISTRY_ID=crp_your_registry_id
IMAGE_TAG=latest

# Database
DB_NAME=llm_system
DB_USER=llm_user
DB_PASSWORD=change_me
DB_SSLMODE=disable

# Redis
REDIS_PASSWORD=

# Auth
JWT_SECRET=change_me_to_long_random_string

# Public API port on VM
API_GATEWAY_PUBLIC_PORT=8080

# Request limits per Telegram/API user
ANALYTICS_DAILY_LIMIT=5
SIMPLE_DAILY_LIMIT=20

# Yandex AI Studio
YANDEX_API_KEY=change_me
DEBATER_A_MODEL=gpt://folder_id/yandexgpt-lite/latest
DEBATER_B_MODEL=gpt://folder_id/deepseek-v32/latest
DEBATER_C_MODEL=gpt://folder_id/yandexgpt-lite/latest
JUDGE_MODEL=gpt://folder_id/yandexgpt-5.1/latest
SIMPLE_MODEL=gpt://folder_id/yandexgpt-lite/latest
DEBATER_MAX_TOKENS=1024
JUDGE_MAX_TOKENS=2048
SIMPLE_MAX_TOKENS=1000
DEBATE_TIMEOUT_SECONDS=300
DEBUG_BACKEND=false

# Telegram
TELEGRAM_BOT_TOKEN=change_me

# Runtime
ENVIRONMENT=production
